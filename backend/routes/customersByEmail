const express = require("express");
const pool = require("../db");
const router = express.Router();

router.get("/customers/email/:email", (req, res) => {
  const sql = "SELECT * FROM customers WHERE emailAddress = ?";
  pool.query(sql, [req.params.email], (err, results) => {
    if (err) {
      console.error("Database error fetching customer:", err);
      return res
        .status(500)
        .json({ error: "Database error fetching customer" });
    }
    if (results.length === 0) {
      return res.status(404).json({ error: "Customer not found" });
    }
    res.status(200).json(results[0]);
  });
});

module.exports = router;
